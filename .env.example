# Ключ Яндекс.Карт (JavaScript API v3). Получить: https://developer.tech.yandex.ru/
# Без ключа на странице контактов показывается OpenStreetMap.
# В настройках ключа (Ограничение по HTTP Referer) укажите домены, по одному в строке:
#   грют.москва
#   localhost
#   127.0.0.1
VITE_YANDEX_MAPS_API_KEY=0067af51-4fb4-4b6d-bac8-a18d42565f64

# Бронирование — URL приёма заявки (POST JSON). Без переменной форма не отправляет запрос.
# Локально в .env: http://localhost:8787/reservation (сервер: npm run server или npm run dev:all).
# Проверка API без UI: с запущенным сервером — npm run test:booking-api
# Продакшен: задано в .env.production (например /reservation.php или HTTPS URL облачного API)
VITE_RESERVATION_API_URL=http://localhost:8787/reservation

# Публичный адрес сайта (HTTPS, без слэша в конце). Для canonical и og:url при сборке.
# Сайт: https://грют.москва — на локалке можно оставить пустым.
VITE_SITE_URL=https://грют.москва

# Ссылка для плавающей кнопки MAX (внизу справа). Пусто — по умолчанию:
#   https://web.max.ru/227198815
# На Android клик открывает приложение MAX через Intent, иначе переход по HTTPS.
VITE_MAX_SOCIAL_URL=
