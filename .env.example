# Ключ Яндекс.Карт (JavaScript API v3). Получить: https://developer.tech.yandex.ru/
# Без ключа на странице контактов показывается OpenStreetMap.
# В настройках ключа (Ограничение по HTTP Referer) укажите домены, по одному в строке:
#   грют.москва
#   localhost
#   127.0.0.1
VITE_YANDEX_MAPS_API_KEY=0067af51-4fb4-4b6d-bac8-a18d42565f64

# Бронь: POST на reservation.php (лежит в dist после сборки). Тот же домен — без CORS-проблем.
# На `npm run dev` PHP не выполняется; чтобы проверить форму локально, временно укажите боевой URL:
# VITE_RESERVATION_API_URL=https://грют.москва/reservation.php
VITE_RESERVATION_API_URL=/reservation.php

# Публичный адрес сайта (HTTPS, без слэша в конце). Для canonical и og:url при сборке.
# Сайт: https://грют.москва — на локалке можно оставить пустым.
VITE_SITE_URL=https://грют.москва

# Ссылка для плавающей кнопки MAX (внизу справа). Пусто — профиль по умолчанию (max.ru/...).
# На Android клик открывает приложение MAX через Intent, иначе переход по HTTPS.
VITE_MAX_SOCIAL_URL=
