# Скопируйте в server/.env и заполните (server/.env в .gitignore).
#
# === Локальная проверка (п. 2) ===
# 1) В корне проекта в .env должно быть: VITE_RESERVATION_API_URL=http://localhost:8787/reservation
#    (см. корневой .env.example)
# 2) Не задавайте NODE_ENV=production локально — иначе без полного SMTP процесс не стартует.
# 3) Без SMTP: сервер всё равно поднимется, заявки логируются в консоль, ответ { ok: true }.
# 4) С SMTP: заполните блок ниже — письма реально уходят.
# 5) Фронт + сервер: npm run dev:all
# 6) Проверка API без браузера (сервер уже запущен): npm run test:booking-api

# Порт HTTP (в облаке часто подставляет платформа; локально по умолчанию 8787)
PORT=8787

# CORS: для локального Vite обязательно оставьте эти origin (порт как в vite.config.js).
# На проде достаточно https://грют.москва — сервер сам добавит punycode-вариант для браузера.
# При необходимости перечислите несколько через запятую (www / без www и т.д.).
ALLOWED_ORIGINS=http://localhost:5177,http://127.0.0.1:5177

# --- Пример Mail.ru / почта на домене через Mail.ru (smtp.mail.ru) ---
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=ваш@грют.москва
# SMTP_PASS=пароль-приложения-или-smtp
# MAIL_TO=куда@приходят-заявки.ru
# MAIL_FROM=ваш@грют.москва
#
# Альтернатива Mail.ru: порт 587 + STARTTLS
# SMTP_PORT=587
# SMTP_SECURE=false

# Универсальный шаблон (другой провайдер — подставьте свои хост/порт из справки)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

MAIL_TO=
MAIL_FROM=

# Необязательно — тема письма
# MAIL_SUBJECT=Бронь с сайта ГРЮТ
